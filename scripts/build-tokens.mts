/**
 * Builds `src/themes/tokens.ts` from the design tokens in `tokens/tokens.json`.
 *
 * The module's `tokenStyles` declares one private alias per token on `:host`,
 * named like the token with a trailing `--`:
 *
 *   --ia-color-text-primary--: var(--ia-color-text-primary, var(--ia-color-palette-gray-850--));
 *
 * Components read the alias. A page that sets `--ia-color-text-primary` (or
 * the palette value it points at) on `:root` or any ancestor overrides it, and
 * a page that sets nothing gets the token's own value. The alias is needed
 * because `--ia-x: var(--ia-x, ...)` is a cycle, and a plain `--ia-x: ...` on
 * `:host` would shadow the page's value.
 *
 * Lengths are px at the browser's default 16px font size. A group marked
 * `$extensions.ia.scale: true` emits `calc(N * var(--ia-unit, 1px))`, so it
 * grows with the user's font-size setting (see src/themes/unit.ts); one marked
 * `false` stays fixed. Neither depends on the page's root font size, and every
 * length has to sit under one or the other.
 */
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const sourcePath = join(root, 'tokens', 'tokens.json');
const outputPath = join(root, 'src', 'themes', 'tokens.ts');

const HEADER =
  '// Generated by scripts/build-tokens.mts from tokens/tokens.json. Do not edit.\n';

interface TokenNode {
  $value?: string;
  $extensions?: { ia?: TokenExtension };
  [key: string]: unknown;
}

interface TokenExtension {
  decision?: string;
  scale?: boolean;
  responsive?: { below: string; value: string };
}

interface Token {
  path: string[];
  value: string;
  ext: TokenExtension;
  /** The nearest group's `scale`, if any group above the token sets one. */
  scale?: boolean;
}

function fail(message: string): never {
  throw new Error(`build-tokens: ${message}`);
}

/** `['font', 'lineHeight', 'tight']` -> `--ia-font-line-height-tight` */
const kebab = (s: string) =>
  s.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase();
const cssName = (path: string[]) => '--ia-' + path.map(kebab).join('-');

/** Rewrites each `{a.b.c}` reference to the referenced token's alias. */
function resolveRefs(value: string, known: Set<string>): string {
  return value.replace(/\{([^}]+)\}/g, (_, ref: string) => {
    const name = cssName(ref.split('.'));
    if (!known.has(name)) {
      fail(`unknown reference {${ref}}`);
    }
    return `var(${name}--)`;
  });
}

function* walk(
  node: TokenNode,
  path: string[] = [],
  scale?: boolean,
): Generator<Token> {
  for (const [key, child] of Object.entries(node)) {
    if (key.startsWith('$') || child === null || typeof child !== 'object') {
      continue;
    }
    const token = child as TokenNode;
    if ('$value' in token) {
      yield {
        path: [...path, key],
        value: String(token.$value),
        ext: token.$extensions?.ia ?? {},
        scale,
      };
    } else {
      yield* walk(token, [...path, key], token.$extensions?.ia?.scale ?? scale);
    }
  }
}

/** A bare px length in a scaling group becomes a multiple of --ia-unit. */
function scaled({ path, value, scale }: Token): string {
  if (/\d(px|rem|em)\b/.test(value) && scale === undefined) {
    fail(`${path.join('.')} is a length outside any group with a scale flag`);
  }
  if (/\d(rem|em)\b/.test(value)) {
    fail(`${path.join('.')} is in rem or em; lengths are px`);
  }
  const px = /^(-?[\d.]+)px$/.exec(value);
  return scale && px ? `calc(${px[1]} * var(--ia-unit, 1px))` : value;
}

const alias = (name: string, fallback: string) =>
  `${name}--: var(${name}, ${fallback});`;

const source = JSON.parse(readFileSync(sourcePath, 'utf8'));
const tokens = [...walk(source)];
const known = new Set(tokens.map((t) => cssName(t.path)));

for (const { path, value } of tokens) {
  if (value.includes('`') || value.includes('${') || value.includes('\\')) {
    fail(`${path.join('.')} contains a backtick, "\${" or backslash`);
  }
}

const declarations = tokens.map(
  (token) =>
    `    ${alias(cssName(token.path), resolveRefs(scaled(token), known))}`,
);

/* Tokens that re-point below a breakpoint, grouped by breakpoint. */
const breakpoints = source.breakpoint as Record<string, { $value: string }>;
const responsive = new Map<string, string[]>();
for (const { path, ext, scale } of tokens) {
  if (!ext.responsive) continue;
  const { below } = ext.responsive;
  const value = scaled({ path, value: ext.responsive.value, ext, scale });
  if (!breakpoints[below]) {
    fail(`${path.join('.')} is responsive below unknown breakpoint "${below}"`);
  }
  const lines = responsive.get(below) ?? [];
  lines.push(`      ${alias(cssName(path), resolveRefs(value, known))}`);
  responsive.set(below, lines);
}
const mediaBlocks = [...responsive]
  .map(
    ([below, lines]) => `
  @media (max-width: ${parseInt(breakpoints[below].$value, 10) - 1}px) {
    :host {
${lines.join('\n')}
    }
  }`,
  )
  .join('\n');

/*
 * The inverse context, for anything drawn on a dark surface. The aliases are
 * computed on :host, so the inverse scope re-points the aliases themselves.
 * Border shorthands resolve where they are declared, so they are re-declared
 * to pick up the inverse colors.
 */
const INVERSE: [string, string][] = [
  ['color-text-primary', 'color-text-inverse'],
  ['color-text-secondary', 'color-text-inverse-secondary'],
  ['color-text-link', 'color-text-inverse-link'],
  ['color-text-link-hover', 'color-text-inverse-link-hover'],
  ['color-border-default', 'color-border-inverse'],
  ['color-border-strong', 'color-palette-gray-400'],
  ['color-border-focus', 'color-border-focus-inverse'],
  ['color-border-focus-band', 'color-border-focus-band-inverse'],
  ['color-surface-page', 'color-surface-chrome'],
  ['color-surface-raised', 'color-surface-chrome-secondary'],
  ['color-hover-overlay', 'color-hover-overlay-inverse'],
  ['color-selected-soft-fill', 'color-selected-soft-fill-inverse'],
  ['color-selected-soft-border', 'color-border-inverse'],
  ['color-selected-soft-text', 'color-text-inverse'],
  ['shadow-focus-band', 'shadow-focus-band-inverse'],
];
const INVERSE_BORDERS: [string, string][] = [
  ['border-control', 'color-border-strong'],
  ['border-card', 'color-border-inverse'],
  ['border-divider', 'color-border-inverse'],
  ['border-table', 'color-border-default'],
];
for (const name of [...INVERSE.flat(), ...INVERSE_BORDERS.flat()]) {
  if (!known.has(`--ia-${name}`)) {
    fail(`the inverse scope names unknown token --ia-${name}`);
  }
}
const inverseLines = [
  ...INVERSE.map(([from, to]) => `    --ia-${from}--: var(--ia-${to}--);`),
  ...INVERSE_BORDERS.map(
    ([from, color]) =>
      `    --ia-${from}--: var(--ia-size-border-width--) solid var(--ia-${color}--);`,
  ),
];

const module = `${HEADER}import { css } from 'lit';
import './unit';

/**
 * Every design token as a private alias on \`:host\`, e.g.
 * \`var(--ia-color-text-primary--)\`. Set the public name
 * (\`--ia-color-text-primary\`) on the page to override it. Lengths that scale
 * are multiples of \`--ia-unit\`, which \`./unit\` sets from the user's default
 * font size.
 *
 * Inside a shadow root, \`.ia-inverse\` re-points the text, border, focus,
 * focus band, surface, hover and selected aliases for a dark surface; \`:host(.ia-inverse)\` does
 * the same for the whole element.
 */
export const tokenStyles = css\`
  :host {
${declarations.join('\n')}
  }
${mediaBlocks}

  :host(.ia-inverse),
  :host([data-ia-surface='inverse']),
  .ia-inverse,
  [data-ia-surface='inverse'] {
${inverseLines.join('\n')}
  }
\`;
`;

mkdirSync(dirname(outputPath), { recursive: true });
writeFileSync(outputPath, module);
console.log(`tokens: ${tokens.length} built`);
