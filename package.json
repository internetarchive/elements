{
  "name": "@internetarchive/elements",
  "version": "1.4.0",
  "description": "A web component library from the Internet Archive.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/internetarchive/elements.git"
  },
  "bugs": {
    "url": "https://github.com/internetarchive/elements/issues"
  },
  "scripts": {
    "dev": "wireit",
    "build": "wireit",
    "clean": "wireit",
    "lint": "wireit",
    "icons:lint": "wireit",
    "typecheck": "wireit",
    "format": "wireit",
    "circular": "wireit",
    "prepare": "wireit",
    "test": "wireit",
    "ghpages:build": "wireit",
    "strings:extract": "wireit",
    "strings:build": "wireit",
    "exports": "wireit",
    "exports:check": "wireit"
  },
  "dependencies": {
    "@internetarchive/fetch-handler": "^1.4.0",
    "@internetarchive/ia-dropdown": "^2.2.0",
    "@internetarchive/icon-close": "^1.4.0",
    "@internetarchive/icon-user": "^1.4.0",
    "@internetarchive/lazy-loader-service": "^0.2.0",
    "@internetarchive/metadata-service": "^1.0.4",
    "@internetarchive/promised-singleton": "^0.2.1",
    "@internetarchive/recaptcha-manager": "^1.0.0",
    "@lit/localize": "^0.12.2",
    "@types/applepayjs": "^14.0.9",
    "@types/braintree-web": "^3.143.0",
    "@types/googlepay": "^0.7.12",
    "@types/grecaptcha": "^3.0.9",
    "@types/paypal-checkout-components": "^4.0.8",
    "currency.js": "^2.0.4",
    "dayjs": "^1.11.23",
    "dompurify": "^3.2.5",
    "lit": "^2.8.0 || ^3.3.2",
    "magic-snowflakes": "^7.0.2",
    "nanoevents": "^9.1.0",
    "throttle-debounce": "^5.0.2",
    "tslib": "^2.8.1",
    "typescript-cookie": "^1.0.6",
    "typescript-memoize": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.1",
    "@internetarchive/local-cache": "1.0.0",
    "@lit/localize-tools": "^0.8.2",
    "@open-wc/testing-helpers": "^3.0.1",
    "@types/node": "^24.13.6",
    "@types/throttle-debounce": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitest/browser": "^4.0.8",
    "@vitest/browser-playwright": "^4.0.8",
    "@vitest/coverage-v8": "^4.0.8",
    "axe-core": "^4.10.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-lit": "^1.15.0",
    "eslint-plugin-lit-a11y": "^4.1.4",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-wc": "^2.2.1",
    "highlight.js": "^11.11.1",
    "madge": "^8.0.0",
    "playwright": "^1.60.0",
    "prettier": "3.6.2",
    "ts-lit-plugin": "^2.0.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wireit": "^0.14.12"
  },
  "exports": {
    "./ia-audio-element": "./dist/src/elements/ia-audio-element/ia-audio-element.js",
    "./ia-button": "./dist/src/elements/ia-button/ia-button.js",
    "./ia-clearable-text-input": "./dist/src/elements/ia-clearable-text-input/ia-clearable-text-input.js",
    "./ia-combo-box": "./dist/src/elements/ia-combo-box/ia-combo-box.js",
    "./ia-donation-thermometer": "./dist/src/elements/ia-donation-thermometer/ia-donation-thermometer.js",
    "./ia-dropdown": "./dist/src/elements/ia-dropdown/ia-dropdown.js",
    "./ia-dropdown-search-bar": "./dist/src/elements/ia-dropdown-search-bar/ia-dropdown-search-bar.js",
    "./ia-expandable-search-bar": "./dist/src/elements/ia-expandable-search-bar/ia-expandable-search-bar.js",
    "./ia-histogram-date-range": "./dist/src/elements/ia-histogram-date-range/ia-histogram-date-range.js",
    "./ia-icon": "./dist/src/elements/ia-icon/ia-icon.js",
    "./ia-image-viewer": "./dist/src/elements/ia-image-viewer/ia-image-viewer.js",
    "./ia-infinite-scroller": "./dist/src/elements/ia-infinite-scroller/ia-infinite-scroller.js",
    "./ia-item-navigator": "./dist/src/elements/ia-item-navigator/ia-item-navigator.js",
    "./ia-otp-form": "./dist/src/elements/ia-otp-form/ia-otp-form.js",
    "./ia-otp-input": "./dist/src/elements/ia-otp-input/ia-otp-input.js",
    "./ia-playback-controls": "./dist/src/elements/ia-playback-controls/ia-playback-controls.js",
    "./ia-radio-player": "./dist/src/elements/ia-radio-player/ia-radio-player.js",
    "./ia-reviews": "./dist/src/elements/ia-reviews/ia-reviews.js",
    "./ia-scrubber-bar": "./dist/src/elements/ia-scrubber-bar/ia-scrubber-bar.js",
    "./ia-sr-only-text": "./dist/src/elements/ia-sr-only-text/ia-sr-only-text.js",
    "./ia-status-indicator": "./dist/src/elements/ia-status-indicator/ia-status-indicator.js",
    "./ia-topnav": "./dist/src/elements/ia-topnav/ia-topnav.js",
    "./ia-transcript-view": "./dist/src/elements/ia-transcript-view/ia-transcript-view.js",
    "./ia-waveform-progress": "./dist/src/elements/ia-waveform-progress/ia-waveform-progress.js",
    "./ia-wayback-search-form": "./dist/src/elements/ia-wayback-search-form/ia-wayback-search-form.js",
    "./modal-manager": "./dist/src/elements/modal-manager/modal-manager.js",
    "./labs/ia-snow": "./dist/src/labs/ia-snow/ia-snow.js",
    "./*": "./dist/src/elements/*.js",
    "./icons/*": "./dist/src/icons/*.js",
    "./icons/*.svg": "./dist/src/icons/*.svg",
    "./labs/*": "./dist/src/labs/*.js",
    "./services/*": "./dist/src/services/*.js",
    "./locales/*.js": "./dist/src/locales/*.js"
  },
  "sideEffects": [
    "./dist/src/elements/**",
    "./dist/src/labs/**",
    "./dist/src/locales/**",
    "./src/elements/**",
    "./src/labs/**",
    "./src/locales/**",
    "./demo/**"
  ],
  "files": [
    "README.md",
    "dist",
    "!dist/**/*.test*",
    "!dist/**/*-story*",
    "!dist/demo",
    "!dist/src/internal",
    "!dist/*.tsbuildinfo"
  ],
  "wireit": {
    "build": {
      "command": "tsc --build --pretty && tsc-alias && rsync -zarvm --prune-empty-dirs --include \"*/\" --include \"*.svg\" --exclude=\"*\" src dist",
      "dependencies": [
        "circular",
        "icons",
        "exports:check"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "circular": {
      "command": "madge --circular --extensions ts ."
    },
    "clean": {
      "command": "rm -rf dist"
    },
    "dev": {
      "command": "vite",
      "dependencies": [
        "icons"
      ]
    },
    "lint": {
      "command": "eslint . && prettier \"**/*.ts\" --check",
      "dependencies": [
        "icons:lint",
        "exports:check"
      ]
    },
    "format": {
      "command": "eslint . --fix && prettier \"**/*.ts\" --write"
    },
    "prepare": {
      "dependencies": [
        "build"
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "files": [
        "src/**/*.ts",
        "demo/**/*.ts",
        "tsconfig.json"
      ],
      "output": [],
      "dependencies": [
        "icons"
      ]
    },
    "test": {
      "command": "vitest",
      "dependencies": [
        "circular",
        "build"
      ]
    },
    "ghpages:build": {
      "command": "vite build --config vite.config.ghpages.ts && touch ./ghpages/.nojekyll",
      "dependencies": [
        "icons"
      ]
    },
    "strings:extract": {
      "command": "lit-localize extract",
      "files": [
        "src/**/*.ts",
        "lit-localize.json",
        "tsconfig.json"
      ]
    },
    "strings:build": {
      "command": "node scripts/build-locales.mts && prettier --write \"src/locales/*.ts\"",
      "files": [
        "xliff/*.xlf",
        "src/**/*.ts",
        "!src/locales/*.ts",
        "lit-localize.json",
        "scripts/build-locales.mts"
      ]
    },
    "exports": {
      "command": "node scripts/build-exports.mts"
    },
    "exports:check": {
      "command": "node scripts/build-exports.mts --check",
      "files": [
        "package.json",
        "src/elements/*/*.ts",
        "src/labs/*/*.ts",
        "scripts/build-exports.mts"
      ],
      "output": []
    },
    "icons:lint": {
      "command": "node scripts/lint-icons.mts",
      "files": [
        "icons/*.svg",
        "icons/.multicolor",
        "scripts/lint-icons.mts",
        "scripts/icon-source.mts"
      ],
      "output": []
    },
    "icons": {
      "command": "node scripts/build-icons.mts",
      "files": [
        "icons/*.svg",
        "scripts/build-icons.mts",
        "scripts/icon-source.mts"
      ],
      "output": [
        "src/icons/**"
      ]
    }
  }
}
