{
  "$description": "archive.org design tokens. Source of truth — src/themes/tokens.ts is generated from this file by scripts/build-tokens.mts.",
  "$meta": {
    "version": "0.1.0",
    "basis": "Measured from live archive.org at 1280px and 375px.",
    "remBasis": "1rem = 10px (archive.org sets html { font-size: 62.5% }). All rem values here assume that.",
    "provenance": "$extensions.ia.live records the live value a token was derived from. $extensions.ia.decision points at an entry in DECISIONS.md. $extensions.ia.delta marks a deliberate departure from live."
  },

  "color": {
    "$type": "color",

    "palette": {
      "$description": "Raw ramp. Never reference these directly in product code — use the semantic roles below.",
      "white":      { "$value": "#ffffff", "$extensions": { "ia": { "live": "--true-white" } } },
      "black":      { "$value": "#000000", "$extensions": { "ia": { "live": "the theater behind the media player and BookReader" } } },
      "gray-50":    { "$value": "#fbfbfd", "$extensions": { "ia": { "live": "--off-white, body background" } } },
      "gray-100":   { "$value": "#f1f1f4", "$extensions": { "ia": { "live": "collection-browser page background" } } },
      "gray-200":   { "$value": "#dddddd", "$extensions": { "ia": { "live": "most common border on search/profile" } } },
      "gray-300":   { "$value": "#cccccc", "$extensions": { "ia": { "live": "--grey80" } } },
      "gray-400":   { "$value": "#aaaaaa", "$extensions": { "ia": { "live": "--grey66, subnav links on dark" } } },
      "gray-500":   { "$value": "#999999", "$extensions": { "ia": { "live": "--grey60", "note": "2.85:1 on white — never use as text on a light surface" } } },
      "gray-600":   { "$value": "#666666", "$extensions": { "ia": { "live": "--grey40, secondary text" } } },
      "gray-700":   { "$value": "#474747", "$extensions": { "ia": { "live": "--grey28" } } },
      "gray-800":   { "$value": "#333333", "$extensions": { "ia": { "live": "--grey20, subnav / secondary CTA" } } },
      "gray-850":   { "$value": "#2c2c2c", "$extensions": { "ia": { "live": "--dark-gray, primary text" } } },
      "gray-900":   { "$value": "#222222", "$extensions": { "ia": { "live": "--grey13, topnav background" } } },
      "navy-50":    { "$value": "#e8edf2", "$extensions": { "ia": { "note": "navy-700 at 10% into white — the soft selected fill" } } },
      "navy-100":   { "$value": "#c5d1df", "$extensions": { "ia": { "live": "--lightest-gray, primary CTA border" } } },
      "navy-300":   { "$value": "#98adc6", "$extensions": { "ia": { "note": "navy-700 at 45% into white — the soft selected edge" } } },
      "navy-700":   { "$value": "#194880", "$extensions": { "ia": { "live": "--navy-blue, primary CTA fill" } } },
      "blue-300":   { "$value": "#9aa8ff", "$extensions": { "ia": { "delta": true, "live": "lightened from #4b64ff for dark chrome", "decision": "D-07", "note": "7.14:1 on #222" } } },
      "blue-600":   { "$value": "#3a4fd6", "$extensions": { "ia": { "delta": true, "live": "darkened from #4b64ff", "decision": "D-07", "note": "6.42:1 on white, 6.22:1 on #fbfbfd, 5.70:1 on #f1f1f4" } } },
      "red-400":    { "$value": "#ff0000", "$extensions": { "ia": { "live": "the topnav donate heart (subnav and mobile), hard-coded", "note": "the heart glyph only" } } },
      "red-500":    { "$value": "#e51c23", "$extensions": { "ia": { "live": "--classic-red", "note": "4.64:1 with white text" } } },
      "red-700":    { "$value": "#b8161c", "$extensions": { "ia": { "delta": true, "live": "darkened from --classic-red", "decision": "D-09", "note": "6.63:1 on white, 5.88:1 on sunken — the danger ink and button border" } } },
      "orange-300": { "$value": "#ffb000", "$extensions": { "ia": { "delta": true, "live": "brightened from --cantaloupe #ee8950", "decision": "D-11", "note": "7.62:1 with #2c2c2c; 1.77:1 against the page, so its edge carries the boundary" } } },
      "orange-600": { "$value": "#cc7a00", "$extensions": { "ia": { "delta": true, "live": "replaces --dark-cantaloupe #ec7939 as the warning edge", "decision": "D-11", "note": "3.20:1 against the page — the warning button edge" } } },
      "orange-700": { "$value": "#a85216", "$extensions": { "ia": { "delta": true, "live": "darkened from --dark-cantaloupe #ec7939", "decision": "D-11", "note": "5.41:1 on white, 4.80:1 on sunken — warning ink" } } },
      "green-700":  { "$value": "#20705a", "$extensions": { "ia": { "delta": true, "live": "darkened from --mint-green #31a481", "decision": "D-10", "note": "5.95:1 with white text and 5.28:1 as text on the sunken surface — serves as both fill and ink" } } },
      "cream":      { "$value": "#fcf5e6", "$extensions": { "ia": { "live": "Wayback Machine hero panel" } } }
    },

    "legacy": {
      "$description": "Live values that no role points at, kept so a live name can still be traced to its value. Never used in new code. A value is deleted once nothing on the live site declares it.",
      "gray-550": { "$value": "#6f6f6f", "$extensions": { "ia": { "live": "--grey6f" } } },
      "blue-500": { "$value": "#4b64ff", "$extensions": { "ia": { "live": "--bright-blue, link color", "note": "4.45:1 on the #fbfbfd page background — fails AA as body text" } } },
      "orange-400": { "$value": "#ee8950", "$extensions": { "ia": { "live": "--cantaloupe, warning fill (drawn nowhere measured)" } } },
      "orange-500": { "$value": "#ec7939", "$extensions": { "ia": { "live": "--dark-cantaloupe, warning border" } } },
      "green-500": { "$value": "#31a481", "$extensions": { "ia": { "live": "--mint-green", "note": "3.11:1 with white text — retained for reference, not for text or fills" } } },
      "brick": { "$value": "#d43f3a", "$extensions": { "ia": { "live": "--brick" } } },
      "coral": { "$value": "#d9534f", "$extensions": { "ia": { "live": "--coral" } } }
    },

    "text": {
      "$description": "Text colors. The lightest permitted text on any light surface is text.secondary — it clears 4.5:1 even on the sunken surface.",
      "primary":    { "$value": "{color.palette.gray-850}", "$extensions": { "ia": { "contrast": "13.97:1 on white, 13.51:1 on page" } } },
      "secondary":  { "$value": "{color.palette.gray-600}", "$extensions": { "ia": { "contrast": "5.74:1 on white, 5.09:1 on sunken" } } },
      "link":       { "$value": "{color.palette.blue-600}", "$extensions": { "ia": { "delta": true, "decision": "D-07" } } },
      "link-hover": { "$value": "{color.palette.navy-700}", "$extensions": { "ia": { "contrast": "9.21:1 on white" } } },
      "inverse":           { "$value": "{color.palette.white}" },
      "inverse-secondary": { "$value": "{color.palette.gray-300}", "$extensions": { "ia": { "contrast": "5.79:1 on #474747, 9.91:1 on #222" } } },
      "inverse-link-hover": { "$value": "{color.palette.white}", "$extensions": { "ia": { "contrast": "15.91:1 on #222, 21:1 on #000" } } },
      "inverse-link":      { "$value": "{color.palette.blue-300}", "$extensions": { "ia": { "delta": true, "decision": "D-07" } } },
      "danger":     { "$value": "{color.palette.red-700}", "$extensions": { "ia": { "delta": true, "decision": "D-09", "contrast": "6.63:1 on white, 5.88:1 on sunken", "note": "#e51c23 is 4.49:1 on the page background — one hundredth short of AA" } } },
      "disabled":   { "$value": "{color.palette.gray-600}", "$extensions": { "ia": { "note": "Disabled text is exempt from contrast minimums but is kept legible anyway." } } }
    },

    "surface": {
      "page":    { "$value": "{color.palette.gray-50}" },
      "raised":  { "$value": "{color.palette.white}" },
      "sunken":  { "$value": "{color.palette.gray-100}" },
      "inverse": { "$value": "{color.palette.gray-850}" },
      "chrome":  { "$value": "{color.palette.gray-900}", "$extensions": { "ia": { "live": "topnav" } } },
      "theater": { "$value": "{color.palette.black}", "$extensions": { "ia": { "live": "the item page's theater, behind the player and BookReader", "use": "with .ia-inverse" } } },
      "chrome-secondary": { "$value": "{color.palette.gray-800}", "$extensions": { "ia": { "live": "subnav, media menu" } } },
      "collection": { "$value": "{color.palette.gray-600}", "$extensions": { "ia": { "live": "the collection tile's card and thumbnail well", "contrast": "5.74:1 with white text" } } },
      "brand-wayback": { "$value": "{color.palette.cream}" },
      "highlight": { "$value": "{color.palette.navy-100}", "$extensions": { "ia": { "live": "a search term marked in a result's text snippet (<mark>, #0000ff33)", "contrast": "9.02:1 with primary text" } } },
      "scrim": { "$value": "rgb(0 0 0 / 0.5)", "$extensions": { "ia": { "use": "behind modals and drawers" } } }
    },

    "border": {
      "$description": "strong is the minimum for any border that conveys the boundary of a control (3:1). subtle is decorative only.",
      "subtle":  { "$value": "{color.palette.gray-200}", "$extensions": { "ia": { "note": "1.36:1 — separators and card edges only, never the only cue for a control" } } },
      "default": { "$value": "{color.palette.gray-300}" },
      "strong":  { "$value": "{color.palette.gray-600}", "$extensions": { "ia": { "contrast": "5.74:1 on white" } } },
      "inverse": { "$value": "{color.palette.gray-700}" },
      "focus":   { "$value": "{color.palette.blue-600}" },
      "focus-inverse": { "$value": "{color.palette.blue-300}" }
    },

    "action": {
      "$description": "CTA roles. Live already names these; only the fills that failed contrast have moved.",
      "primary-fill":   { "$value": "{color.palette.navy-700}", "$extensions": { "ia": { "live": "--ia-theme-primary-cta-fill", "contrast": "9.21:1 with white" } } },
      "primary-border": { "$value": "{color.palette.navy-100}", "$extensions": { "ia": { "live": "--ia-theme-primary-cta-border" } } },
      "primary-text":   { "$value": "{color.palette.white}" },
      "secondary-fill":   { "$value": "{color.palette.white}", "$extensions": { "ia": { "delta": true, "live": "--ia-theme-secondary-cta-fill #333333", "decision": "D-52", "note": "light, so a supporting action never outweighs the primary one" } } },
      "secondary-border": { "$value": "{color.palette.gray-600}", "$extensions": { "ia": { "live": "--ia-theme-secondary-cta-border", "contrast": "5.56:1 against the page — the border carries the boundary" } } },
      "secondary-text":   { "$value": "{color.palette.gray-850}", "$extensions": { "ia": { "delta": true, "live": "white", "decision": "D-52", "contrast": "13.97:1" } } },
      "danger-fill":   { "$value": "{color.palette.red-500}", "$extensions": { "ia": { "delta": true, "live": "--ia-theme-danger-cta-fill #d9534f (3.96:1)", "decision": "D-09" } } },
      "danger-border": { "$value": "{color.palette.red-700}", "$extensions": { "ia": { "delta": true, "live": "--ia-theme-danger-cta-border #d43f3a", "decision": "D-09", "contrast": "5.88:1 against every light surface" } } },
      "danger-text":   { "$value": "{color.palette.white}", "$extensions": { "ia": { "contrast": "4.64:1" } } },
      "warning-fill":   { "$value": "{color.palette.orange-300}", "$extensions": { "ia": { "delta": true, "live": "--ia-theme-warning-cta-fill #ee8950", "decision": "D-11" } } },
      "warning-border": { "$value": "{color.palette.orange-600}", "$extensions": { "ia": { "delta": true, "live": "--ia-theme-warning-cta-border #ec7939 (2.76:1 against the page)", "decision": "D-11", "note": "The #ee8950 fill is only 2.44:1 against the page, so this border is what makes the button perceivable and must itself clear 3:1." } } },
      "warning-text":   { "$value": "{color.palette.gray-850}", "$extensions": { "ia": { "delta": true, "live": "white (2.52:1)", "decision": "D-11", "contrast": "7.62:1" } } },
      "donate-fill":   { "$value": "{color.palette.green-700}", "$extensions": { "ia": { "decision": "D-53", "contrast": "5.95:1 with white, 5.76:1 against the page" } } },
      "donate-border": { "$value": "{color.palette.green-700}", "$extensions": { "ia": { "decision": "D-53" } } },
      "donate-text":   { "$value": "{color.palette.white}" },
      "donate-subtle": { "$value": "#b8f5e2", "$extensions": { "ia": { "live": "ia-donation-thermometer track", "contrast": "4.88:1 with donate-fill text", "note": "a pale mint behind donate green, never behind body text" } } },
      "disabled-fill":   { "$value": "{color.palette.gray-600}", "$extensions": { "ia": { "live": "--ia-theme-disabled-cta-fill" } } },
      "disabled-border": { "$value": "{color.palette.gray-500}", "$extensions": { "ia": { "live": "--ia-theme-disabled-cta-border" } } },
      "disabled-text":   { "$value": "{color.palette.white}" }
    },

    "hover": {
      "$description": "Hover for rows and non-filled controls. Translucent, so it darkens whatever surface it sits on, sunken included. Apply as a layer (background-image), never as a replacement fill.",
      "overlay": { "$value": "rgb(0 0 0 / 0.06)", "$extensions": { "ia": { "note": "#fff -> #f0f0f0, #f1f1f4 -> #e3e3e5" } } },
      "overlay-inverse": { "$value": "rgb(255 255 255 / 0.12)", "$extensions": { "ia": { "note": "what .ia-inverse re-points overlay to; #222 -> #3d3d3d" } } }
    },

    "selected": {
      "$description": "The one selected look, in two tiers. strong: the state is the content (current page, applied filter, checked box). soft: one chosen among neutral controls (view switch, segmented control, menu and dropdown option). Never color alone — strong pairs with aria-current or a check; soft with its border and, in lists, a check.",
      "strong-fill": { "$value": "{color.palette.navy-700}", "$extensions": { "ia": { "contrast": "9.21:1 with white" } } },
      "strong-text": { "$value": "{color.palette.white}" },
      "soft-fill":   { "$value": "{color.palette.navy-50}", "$extensions": { "ia": { "note": "re-points to soft-fill-inverse inside .ia-inverse" } } },
      "soft-fill-inverse": { "$value": "{color.palette.gray-600}", "$extensions": { "ia": { "note": "the soft fill on a dark panel — what .ia-inverse and the dropdown panel re-point soft-fill to", "contrast": "5.74:1 with white text" } } },
      "soft-border": { "$value": "{color.palette.navy-300}", "$extensions": { "ia": { "note": "2.30:1 — decorative; the fill and text carry the state" } } },
      "soft-text":   { "$value": "{color.palette.navy-700}", "$extensions": { "ia": { "contrast": "7.82:1 on the soft fill" } } }
    },

    "status": {
      "success": { "$value": "{color.palette.green-700}", "$extensions": { "ia": { "delta": true, "live": "--mint-green #31a481 (3.11:1 with white)", "decision": "D-10" } } },
      "warning": { "$value": "{color.palette.orange-700}", "$extensions": { "ia": { "delta": true, "live": "--dark-cantaloupe #ec7939 (2.85:1 on white)", "decision": "D-11" } } },
      "danger":  { "$value": "{color.palette.red-700}", "$extensions": { "ia": { "delta": true, "live": "--ia-theme-color-danger #e51c23", "decision": "D-09" } } },
      "info":    { "$value": "{color.palette.navy-700}" },
      "success-subtle": { "$value": "#edf4f2", "$extensions": { "ia": { "note": "success at 8% into white", "contrast": "12.52:1 with primary text" } } },
      "success-border": { "$value": "#b1cdc5", "$extensions": { "ia": { "note": "success at 35% into white — decorative" } } },
      "warning-subtle": { "$value": "#f8f1ec", "$extensions": { "ia": { "note": "warning at 8% into white", "contrast": "12.49:1 with primary text" } } },
      "warning-border": { "$value": "#e1c2ad", "$extensions": { "ia": { "note": "warning at 35% into white — decorative" } } },
      "danger-subtle":  { "$value": "#f9eced", "$extensions": { "ia": { "note": "danger at 8% into white", "contrast": "12.14:1 with primary text" } } },
      "danger-border":  { "$value": "#e6adb0", "$extensions": { "ia": { "note": "danger at 35% into white — decorative" } } },
      "info-subtle":    { "$value": "#edf0f5", "$extensions": { "ia": { "note": "info at 8% into white", "contrast": "12.23:1 with primary text" } } },
      "info-border":    { "$value": "#afbfd3", "$extensions": { "ia": { "note": "info at 35% into white — decorative" } } }
    },

    "environment": {
      "$description": "The non-production badge in the topnav, so a tab on a dev or staging host is never mistaken for production. Never rendered in production.",
      "development": { "$value": "{color.palette.green-700}", "$extensions": { "ia": { "contrast": "5.95:1 with white" } } },
      "staging":     { "$value": "{color.palette.orange-700}", "$extensions": { "ia": { "contrast": "5.41:1 with white" } } }
    },

    "brand": {
      "donate":  { "$value": "{color.palette.red-400}", "$extensions": { "ia": { "live": "the topnav heart, unchanged", "note": "the heart glyph only; donation buttons are the green action.donate-*" } } },
      "navy":    { "$value": "{color.palette.navy-700}" },
      "wayback": { "$value": "{color.palette.cream}" }
    },
    "mediatype": {
      "$description": "Media-type accent, read from tile-mediatype-icon's color map in the live bundle. Colors the media-type glyph in an item tile's stat row. Values below 3:1 on white are darkened, hue kept (D-43). etree takes audio's value and video takes movies', as live.",
      "texts": {
        "$value": "#c5872f",
        "$extensions": {
          "ia": {
            "delta": true,
            "live": "darkened from #faab3c",
            "decision": "D-43",
            "note": "3.05:1 on white"
          }
        }
      },
      "movies": {
        "$value": "#f1644b",
        "$extensions": {
          "ia": {
            "live": "#f1644b",
            "note": "3.15:1 on white"
          }
        }
      },
      "audio": {
        "$value": "#009fdc",
        "$extensions": {
          "ia": {
            "delta": true,
            "live": "darkened from #00adef",
            "decision": "D-43",
            "note": "3.00:1 on white"
          }
        }
      },
      "software": {
        "$value": "#7b9f3e",
        "$extensions": {
          "ia": {
            "delta": true,
            "live": "darkened from #9ecc4f",
            "decision": "D-43",
            "note": "3.06:1 on white"
          }
        }
      },
      "image": {
        "$value": "#9c8db9",
        "$extensions": {
          "ia": {
            "delta": true,
            "live": "darkened from #aa99c9",
            "decision": "D-43",
            "note": "3.03:1 on white"
          }
        }
      },
      "web": {
        "$value": "#b28f1b",
        "$extensions": {
          "ia": {
            "delta": true,
            "live": "darkened from #ffcd27",
            "decision": "D-43",
            "note": "3.07:1 on white"
          }
        }
      },
      "data": {
        "$value": "#333333",
        "$extensions": {
          "ia": {
            "live": "#333333",
            "note": "12.63:1 on white"
          }
        }
      },
      "collection": {
        "$value": "#4666ff",
        "$extensions": {
          "ia": {
            "live": "#4666ff",
            "note": "4.56:1 on white"
          }
        }
      },
      "tv": {
        "$value": "#f1644b",
        "$extensions": {
          "ia": {
            "live": "#f1644b",
            "note": "3.15:1 on white"
          }
        }
      },
      "radio": {
        "$value": "#679dac",
        "$extensions": {
          "ia": {
            "delta": true,
            "live": "darkened from #8fdaef",
            "decision": "D-43",
            "note": "3.00:1 on white"
          }
        }
      },
      "film": {
        "$value": "#bf1b2c",
        "$extensions": {
          "ia": {
            "live": "#bf1b2c",
            "note": "6.16:1 on white"
          }
        }
      }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "base": {
        "$value": "\"Helvetica Neue\", Helvetica, Arial, \"Noto Sans\", sans-serif",
        "$extensions": { "ia": { "live": "--ia-theme-base-font-family; the dominant of four live stacks", "decision": "D-02" } }
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Courier New\", monospace",
        "$extensions": { "ia": { "live": "--ia-theme-monospace-font-family, unchanged" } }
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Eight steps. Both ends already existed as tokens: 1.4rem is --ia-theme-font-size-standard, 3.6rem is --ia-theme-font-size-lg.",
      "xs":  { "$value": "1.1rem", "$extensions": { "ia": { "px": 11, "live": "absorbs 10px and 11px" } } },
      "sm":  { "$value": "1.2rem", "$extensions": { "ia": { "px": 12, "live": "absorbs 12px, 13px and the unstyled 13.333px" } } },
      "md":  { "$value": "1.4rem", "$extensions": { "ia": { "px": 14, "live": "unchanged — the body size on every page" } } },
      "lg":  { "$value": "1.6rem", "$extensions": { "ia": { "px": 16, "live": "absorbs 16px and 17px" } } },
      "xl":  { "$value": "2.0rem", "$extensions": { "ia": { "px": 20, "live": "absorbs 18, 20, 21, 22px" } } },
      "2xl": { "$value": "2.4rem", "$extensions": { "ia": { "px": 24, "live": "absorbs 24, 26px" } } },
      "3xl": { "$value": "2.8rem", "$extensions": { "ia": { "px": 28, "live": "absorbs 28, 30px" } } },
      "4xl": { "$value": "3.6rem", "$extensions": { "ia": { "px": 36, "live": "absorbs 35, 36px" } } }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "Two weights, the two every fallback font has. 200, 300, 500 and 600 are live but retired — see D-03.",
      "regular": { "$value": "400" },
      "bold":    { "$value": "700" }
    },
    "lineHeight": {
      "$type": "number",
      "tight":   { "$value": "1.25", "$extensions": { "ia": { "use": "headings, dense UI — tile titles, facet labels — and control labels", "live": "replaces the 14/15 (1.07) tile title", "delta": true } } },
      "normal":  { "$value": "1.45", "$extensions": { "ia": { "use": "body copy", "live": "14/20 in legacy chrome; resolves the competing 14/17", "decision": "D-04" } } },
      "relaxed": { "$value": "1.6",  "$extensions": { "ia": { "use": "long-form prose, item descriptions" } } }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "5px base — the spacing already clustered here in the live CSS (5/10/15/20/30/40).",
    "1":  { "$value": "0.5rem", "$extensions": { "ia": { "px": 5 } } },
    "2":  { "$value": "1rem",   "$extensions": { "ia": { "px": 10 } } },
    "3":  { "$value": "1.5rem", "$extensions": { "ia": { "px": 15 } } },
    "4":  { "$value": "2rem",   "$extensions": { "ia": { "px": 20 } } },
    "6":  { "$value": "3rem",   "$extensions": { "ia": { "px": 30 } } },
    "8":  { "$value": "4rem",   "$extensions": { "ia": { "px": 40 } } },
    "12": { "$value": "6rem",   "$extensions": { "ia": { "px": 60 } } },
    "16": { "$value": "8rem",   "$extensions": { "ia": { "px": 80 } } },
    "page": {
      "block": { "$value": "{space.16}", "$extensions": { "ia": { "px": 80, "use": "above and below the page content", "responsive": { "below": "md", "value": "{space.8}" } } } }
    }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Five values replace the fourteen measured live. See D-13.",
    "sm":     { "$value": "0.2rem", "$extensions": { "ia": { "px": 2, "use": "checkboxes, tags, corners nested tight inside another control" } } },
    "default":{ "$value": "0.4rem", "$extensions": { "ia": { "px": 4, "live": "--ia-theme-button-border-radius; the most common live radius by a wide margin", "use": "buttons, inputs, cards, tiles, messages, modals, panels, tooltips, segments" } } },
    "lg":     { "$value": "0.8rem", "$extensions": { "ia": { "px": 8, "live": "homepage collection tiles", "use": "media cards, the hero panel, the segmented track" } } },
    "pill":   { "$value": "999rem", "$extensions": { "ia": { "live": "'Search this collection' and the topnav search field", "use": "search fields, chips, badges, the switch track" } } },
    "circle": { "$value": "50%", "$extensions": { "ia": { "use": "avatars, round icon-only buttons, the switch knob" } } }
  },

  "border": {
    "$description": "Complete border shorthands. Declared on :root, so they resolve against :root's colors — .ia-inverse re-declares them.",
    "control": { "$value": "{size.borderWidth} solid {color.border.strong}",  "$extensions": { "ia": { "use": "any edge that defines a control — 3:1" } } },
    "card":    { "$value": "{size.borderWidth} solid {color.border.subtle}",  "$extensions": { "ia": { "use": "card and tile edges; light overlays with no scrim" } } },
    "divider": { "$value": "{size.borderWidth} solid {color.border.subtle}",  "$extensions": { "ia": { "use": "rules between groups and rows" } } },
    "table":   { "$value": "{size.borderWidth} solid {color.border.default}", "$extensions": { "ia": { "use": "table rules" } } }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Four shadows, each named for its job, replace the five unrelated live shadows. Opaque offset shadows are retired — see D-14.",
    "raised":   { "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.15)", "$extensions": { "ia": { "live": "already used on the topnav", "use": "a card at rest, the topnav, the chosen segment" } } },
    "hover":    { "$value": "0 2px 6px 0 rgba(0, 0, 0, 0.15)", "$extensions": { "ia": { "use": "an interactive card or tile on hover" } } },
    "overlay":  { "$value": "0 4px 16px 0 rgba(0, 0, 0, 0.18)", "$extensions": { "ia": { "use": "modal, drawer, dropdown and menu panels, the facet sheet, toast, the item viewer's image" } } },
    "floating": { "$value": "0 1px 4px 0 rgba(0, 0, 0, 0.35)", "$extensions": { "ia": { "use": "a control that always sits over media — the tile info button, player overlays" } } }
  },

  "blur": {
    "$type": "dimension",
    "scrim": { "$value": "3px", "$extensions": { "ia": { "use": "behind a modal surface only — modal, drawer, sheet. A non-modal overlay gets neither blur nor scrim." } } }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "Four breakpoints replace the 58 distinct media queries measured live. See D-15.",
    "sm": { "$value": "480px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "890px", "$extensions": { "ia": { "live": "350 uses; the topnav switches here. Unusual but load-bearing." } } },
    "xl": { "$value": "1200px" }
  },

  "container": {
    "$type": "dimension",
    "page":  { "$value": "135rem", "$extensions": { "ia": { "px": 1350, "live": "--app-page-max-width" } } },
    "prose": { "$value": "100rem", "$extensions": { "ia": { "px": 1000, "live": ".info-box" } } },
    "form":  { "$value": "60rem",  "$extensions": { "ia": { "px": 600, "live": "signup form wrapper" } } },
    "gutter":        { "$value": "{space.4}" },
    "gutter-narrow": { "$value": "{space.3}", "$extensions": { "ia": { "use": "at and below the md breakpoint" } } }
  },

  "size": {
    "$type": "dimension",
    "control": {
      "sm": { "$value": "3rem",   "$extensions": { "ia": { "px": 30, "live": "the most common live button height" } } },
      "md": { "$value": "3.6rem", "$extensions": { "ia": { "px": 36, "live": "--ia-theme-button-height" } } },
      "lg": { "$value": "4.4rem", "$extensions": { "ia": { "px": 44, "use": "touch-first contexts and primary form submits" } } },
      "xl": { "$value": "5rem",   "$extensions": { "ia": { "px": 50, "live": "the homepage search bar", "use": "the large search bar only" } } }
    },
    "icon": {
      "xs": { "$value": "1.2rem", "$extensions": { "ia": { "px": 12, "live": "the ia-dropdown caret", "use": "carets and disclosure chevrons beside small text" } } },
      "sm": { "$value": "1.6rem", "$extensions": { "ia": { "px": 16 } } },
      "md": { "$value": "2rem",   "$extensions": { "ia": { "px": 20, "live": "--ia-theme-icon-width" } } },
      "lg": { "$value": "2.4rem", "$extensions": { "ia": { "px": 24 } } },
      "xl": { "$value": "3.2rem", "$extensions": { "ia": { "px": 32, "live": "--userIconWidth" } } },
      "2xl":{ "$value": "4rem",   "$extensions": { "ia": { "px": 40, "live": "topnav media buttons" } } }
    },
    "target": {
      "min": { "$value": "4.4rem", "$extensions": { "ia": { "px": 44, "decision": "D-17", "note": "Minimum hit area for any pointer target. The visual box may be smaller." } } }
    },
    "focusRing":       { "$value": "2px" },
    "focusRingOffset": { "$value": "2px" },
    "borderWidth":     { "$value": "1px" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "50ms",  "$extensions": { "ia": { "live": "transform 0.05s ease — tile press" } } },
      "fast":    { "$value": "100ms", "$extensions": { "ia": { "live": "background/color hovers", "use": "small state changes — checked, selected, expanded. Never hover, which snaps (D-54)" } } },
      "base":    { "$value": "200ms", "$extensions": { "ia": { "live": "the most common live duration" } } },
      "slow":    { "$value": "300ms", "$extensions": { "ia": { "live": "drawer and panel slides" } } },
      "spin":    { "$value": "700ms", "$extensions": { "ia": { "use": "one revolution of any spinner, linear. Continuous, so exempt from the 300ms cap." } } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$extensions": { "ia": { "live": "replaces bare `ease`", "delta": true } } },
      "enter":    { "$value": "cubic-bezier(0, 0, 0.2, 1)",   "$extensions": { "ia": { "live": "replaces `ease-out`" } } },
      "exit":     { "$value": "cubic-bezier(0.4, 0, 1, 1)",   "$extensions": { "ia": { "live": "replaces `ease-in`" } } },
      "linear":   { "$value": "linear" },
      "state":    { "$value": "{motion.easing.standard}", "$extensions": { "ia": { "use": "checked, selected, expanded and disabled changes" } } }
    },
    "pressScale": {
      "$type": "number",
      "$description": "Scale on :active, tiered by width so the edge travels about 1.5px. Only self-contained controls scale; rows and surfaces never do.",
      "compact": { "$value": "0.92",  "$extensions": { "ia": { "use": "square icon controls" } } },
      "default": { "$value": "0.97",  "$extensions": { "ia": { "use": "text buttons" } } },
      "wide":    { "$value": "0.985", "$extensions": { "ia": { "use": "full-width buttons, the search bar submit row, tiles", "live": "transform 0.05s — tile press" } } }
    }
  },

  "zIndex": {
    "$type": "number",
    "$description": "Named layers replace the live 1,2,3,4,5,6,10,101,2000000000 free-for-all. See D-16.",
    "raised":   { "$value": "10" },
    "sticky":   { "$value": "100" },
    "dropdown": { "$value": "200" },
    "header":   { "$value": "300" },
    "overlay":  { "$value": "400" },
    "modal":    { "$value": "500" },
    "toast":    { "$value": "600" },
    "tooltip":  { "$value": "700" },
    "local": {
      "$description": "Ordinals for layering inside a component whose root sets isolation: isolate. Meaningless outside that scope.",
      "1": { "$value": "1" }, "2": { "$value": "2" }, "3": { "$value": "3" }, "4": { "$value": "4" }, "5": { "$value": "5" }
    }
  }
}
